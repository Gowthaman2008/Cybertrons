{
  "manifest_version": 3,
  "name": "ScamCheck Companion",
  "version": "1.0.0",
  "description": "Checks highlighted job and internship offers for potential recruitment scams and phishing indicators.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ScamCheck Manual Scanner"
  },
  "host_permissions": [
    "http://localhost:3000/*",
    "https://cybertrons.vercel.app/*"
  ]
}
